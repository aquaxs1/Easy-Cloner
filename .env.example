# ══════════════════════════════════════════════════════════════════════════════
#  Easy Server Cloner — configuration
# ══════════════════════════════════════════════════════════════════════════════
#
#  How to use this file:
#    1. Copy it:    cp .env.example .env
#    2. Put your real bot token in below
#    3. Start:      python main.py
#
#  .gitignore excludes .env from the repository, so it NEVER lands on GitHub.
#  Put secrets there and nowhere else — never directly in the Python code.
# ══════════════════════════════════════════════════════════════════════════════

# ─── REQUIRED ─────────────────────────────────────────────────────────────────

# Bot token from the Discord Developer Portal:
#   https://discord.com/developers/applications  →  your bot  →  "Bot"  →  "Reset Token"
DISCORD_TOKEN=put.your.bot-token.here

# ─── RECOMMENDED ──────────────────────────────────────────────────────────────

# Discord user IDs allowed to operate the bot (comma-separated).
# Leave it empty and ANY server administrator can clone.
# Get your ID by right-clicking yourself with developer mode enabled.
OWNER_IDS=

# Test server ID. When set, slash commands are registered only there and appear
# instantly — handy while developing. Leave empty for global commands, which
# can take up to an hour before Discord serves them.
DEV_GUILD_ID=

# ─── OPTIONAL: defaults ───────────────────────────────────────────────────────

# Defaults for /clone — always overridable in the command itself.
SOURCE_GUILD_ID=
TARGET_GUILD_ID=

# ─── OPTIONAL: behaviour ──────────────────────────────────────────────────────

# Starting pause between individual API calls, in seconds (minimum 0.25).
# The bot raises it automatically as soon as Discord throttles, and lowers it
# again once things are quiet — so this value is only the starting point.
CLONE_DELAY=0.6

# Accent colour of the embeds, as a hex value.
EMBED_COLOR=0x5865F2

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ─── OPTIONAL: features needing privileged intents ────────────────────────────
#
#  CAREFUL: these switches are not enough on their own. The matching intent
#  also has to be enabled in the Developer Portal:
#    https://discord.com/developers/applications → your bot → "Bot"
#    → the "Privileged Gateway Intents" section
#
#  If a switch here is on but the intent in the portal is off, Discord refuses
#  the login entirely. When in doubt, leave both false.

# Enables `/clone messages:<n>` — re-stages the last n messages per channel
# through a webhook. Needs the "Message Content Intent".
ENABLE_MESSAGE_CLONE=false

# Enables `/clone member_roles:True` — gives roles to members present on both
# servers. Needs the "Server Members Intent".
ENABLE_MEMBER_ROLES=false
