# ══════════════════════════════════════════════════════════════════════════════
#  Easy Server Cloner — Konfiguration
# ══════════════════════════════════════════════════════════════════════════════
#
#  So benutzt du diese Datei:
#    1. Kopiere sie:   cp .env.example .env
#    2. Trage unten deinen echten Bot-Token ein
#    3. Starte:        python main.py
#
#  Die .env ist über die .gitignore vom Repository ausgeschlossen und landet
#  damit NIE auf GitHub. Trage Secrets ausschliesslich dort ein — niemals
#  direkt im Python-Code.
# ══════════════════════════════════════════════════════════════════════════════

# ─── PFLICHT ──────────────────────────────────────────────────────────────────

# Bot-Token aus dem Discord Developer Portal:
#   https://discord.com/developers/applications  →  dein Bot  →  "Bot"  →  "Reset Token"
DISCORD_TOKEN=hier.deinen.bot-token.eintragen

# ─── EMPFOHLEN ────────────────────────────────────────────────────────────────

# Discord-User-IDs, die den Bot bedienen dürfen (Komma-getrennt).
# Bleibt das Feld leer, darf JEDER Server-Administrator klonen.
# Deine ID bekommst du mit aktiviertem Entwicklermodus per Rechtsklick auf dich selbst.
OWNER_IDS=

# Test-Server-ID. Ist sie gesetzt, werden die Slash-Commands sofort nur dort
# registriert (praktisch beim Entwickeln). Leer lassen = globale Commands,
# die bis zu einer Stunde brauchen, bis Discord sie ausliefert.
DEV_GUILD_ID=

# ─── OPTIONAL: Vorbelegungen ──────────────────────────────────────────────────

# Vorbelegung für /clone — kann im Command jederzeit überschrieben werden.
SOURCE_GUILD_ID=
TARGET_GUILD_ID=

# ─── OPTIONAL: Verhalten ──────────────────────────────────────────────────────

# Ausgangspause zwischen einzelnen API-Aufrufen in Sekunden (Minimum 0.25).
# Der Bot erhöht sie automatisch, sobald Discord bremst, und senkt sie wieder,
# wenn es ruhig läuft — dieser Wert ist also nur der Startpunkt.
CLONE_DELAY=0.6

# Akzentfarbe der Embeds als Hex-Wert.
EMBED_COLOR=0x5865F2

# Log-Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ─── OPTIONAL: Funktionen mit privilegierten Intents ──────────────────────────
#
#  ACHTUNG: Beide Schalter reichen allein NICHT. Der zugehörige Intent muss
#  zusätzlich im Developer Portal freigeschaltet werden:
#    https://discord.com/developers/applications → dein Bot → "Bot"
#    → Abschnitt "Privileged Gateway Intents"
#
#  Ist ein Schalter hier an, der Intent im Portal aber aus, verweigert Discord
#  den Login komplett. Im Zweifel beides auf false lassen.

# Erlaubt `/clone messages:<n>` — baut die letzten n Nachrichten je Channel per
# Webhook nach. Braucht den "Message Content Intent".
ENABLE_MESSAGE_CLONE=false

# Erlaubt `/clone member_roles:True` — verteilt Rollen an Mitglieder, die auf
# beiden Servern sind. Braucht den "Server Members Intent".
ENABLE_MEMBER_ROLES=false
